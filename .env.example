# ============================================================================
# Chronicle — Environment Variables
#
# Copy this file to `.env.local` for local development (never commit `.env.local`)
# or set these as Environment Variables in your Vercel project.
#
# All variables are OPTIONAL — the demo runs 100% out of the box without any of
# them (deterministic seed + in-memory store).
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase persistence (required only for real database persistence)
# ----------------------------------------------------------------------------
# Enable state persistence to Supabase. When BOTH are set, the app stores the
# full workspace snapshot (sources, claims, conflicts, gaps, next actions,
# who-to-ask, handover snapshot, audit log) in the `chronicle_state` table, so
# a page refresh or a Vercel serverless cold start does not lose state.
#
# Before enabling, run supabase/migrations/001_init_schema.sql in the Supabase
# SQL Editor (or `npx supabase db push`) so the tables exist.
#
# Get these from Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# LLM reconstruction (optional — enables the real AI claim-extraction path)
# ----------------------------------------------------------------------------
# When one of these is set, the reconstructor sends sanitized source text to the
# model and forces a strict, Zod-validated JSON array of claims. Any failure or
# 30-second timeout falls back to the deterministic heuristic, so the demo never
# breaks. Set only ONE to avoid ambiguity (Gemini is preferred if both exist).

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini 3.5 Flash — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model id override. Leave blank to use the default gemini-3.5-flash.
GEMINI_MODEL=

# ----------------------------------------------------------------------------
# GitHub API (optional — raises the ingestion rate limit)
# ----------------------------------------------------------------------------
# The GitHub PR ingestion endpoint calls the public GitHub API unauthenticated
# (60 req/hr per IP). Attach a token to raise this to 5000 req/hr. A classic
# PAT or a fine-grained token with read access to public repos works. If missing,
# requests still succeed but are rate-limited.

GITHUB_TOKEN=
